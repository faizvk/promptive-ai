# Base URL of the Promptive AI backend API.
# Local dev:  http://localhost:5000
# Production: https://your-backend.example.com
VITE_API_BASE_URL=http://localhost:5000

# Optional Cloudflare Turnstile site key. Leave empty to disable the captcha
# widget on signup/login. Must be paired with TURNSTILE_SECRET on the backend.
VITE_TURNSTILE_SITE_KEY=

# Razorpay public key id (test or live). Required for the in-page Checkout
# widget to render. Pair with backend RAZORPAY_KEY_ID/SECRET.
VITE_RAZORPAY_KEY_ID=
