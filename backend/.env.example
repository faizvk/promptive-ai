# =========================
# Server
# =========================
PORT=5000
NODE_ENV=development

# Public URLs used for OAuth redirects + CORS
# In production these point to your deployed frontend/backend.
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# =========================
# Database
# =========================
MONGO_URI=mongodb://localhost:27017/promptive-ai

# =========================
# JWT
# =========================
# Used to sign auth tokens. Generate a long random string in production.
SECRET_KEY=replace-with-a-long-random-secret

# =========================
# Cloudinary (image storage)
# =========================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =========================
# AI providers
# =========================
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=

# =========================
# Google OAuth (optional — sign-in with Google)
# =========================
# Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
