# =========================
# Server
# =========================
PORT=5000
NODE_ENV=development

# Public URLs used for OAuth redirects + CORS
# In production these point to your deployed frontend/backend.
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# =========================
# Database
# =========================
MONGO_URI=mongodb://localhost:27017/promptive-ai

# =========================
# JWT
# =========================
# Used to sign auth tokens. Generate a long random string in production.
SECRET_KEY=replace-with-a-long-random-secret

# =========================
# Cloudinary (image storage)
# =========================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# =========================
# AI providers
# =========================
GEMINI_API_KEY=
HUGGINGFACE_API_KEY=

# =========================
# Google OAuth (optional — sign-in with Google)
# =========================
# Leave empty to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =========================
# Token + cookie TTLs (optional, defaults shown)
# =========================
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# =========================
# SMTP (optional — emails fall back to console logging when unset)
# Use any provider: SES, Mailgun, SendGrid, Postmark, etc.
# =========================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Promptive AI <no-reply@promptive.ai>"

# =========================
# Cloudflare Turnstile (optional — adds CAPTCHA on signup/login)
# Get a secret key at https://dash.cloudflare.com/?to=/:account/turnstile
# Leave empty to disable.
# =========================
TURNSTILE_SECRET=

# =========================
# Additional AI providers (all optional — features auto-detect availability)
# =========================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
ELEVENLABS_API_KEY=
REPLICATE_API_TOKEN=

# =========================
# Razorpay payments (test mode keys are fine for non-prod environments)
# Sign up at https://dashboard.razorpay.com/ → Settings → API Keys.
# WEBHOOK_SECRET is configured under Settings → Webhooks.
# =========================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Razorpay subscription plan IDs (optional — the backend will auto-create
# matching monthly plans on the first /subscribe call and cache the IDs in
# the Setting collection if these are left empty).
# Set these only if you want to point at plans you've created manually in
# the Razorpay dashboard (Subscriptions → Plans).
RAZORPAY_PLAN_ID_PRO=
RAZORPAY_PLAN_ID_BUSINESS=
